# ---------------------------------------------------------------------------
# Local development. Copy to .env and adjust. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- database ---------------------------------------------------------------
# Leave empty locally to use the SQLite file backend/data/crop_advisor.db.
# In production (Render free tier) this MUST be a free hosted Postgres, because
# Render's free disk is ephemeral:
#   Neon     postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#   Supabase postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# --- auth -------------------------------------------------------------------
# Use a long random string in production (Render can generate one).
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_HOURS=24

# --- seed bootstrap ---------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@cropadvisor.in
BOOTSTRAP_ADMIN_PASSWORD=admin123

# --- app --------------------------------------------------------------------
CORS_ORIGINS=*
DEFAULT_LOCALE=en
LOG_LEVEL=INFO
# Set to 1 to load the model at boot instead of on the first prediction.
WARM_MODEL=0
PORT=5000
FLASK_DEBUG=0
